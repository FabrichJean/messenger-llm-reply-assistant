# --- à remplir -------------------------------------------------------------------------------------------
# Mot de passe d'accès au hub (OBLIGATOIRE : le hub refuse de démarrer sans lui). Longue phrase conseillée.
HUB_ADMIN_USER=admin
HUB_PASSWORD=
# Fuseau horaire (heures affichées dans l'interface et le journal)
TZ=Europe/Paris

# --- accès par domaine (profil https) ----------------------------------------------------------------------
# Nom de domaine qui pointe vers le VPS (enregistrement A/AAAA). Laisse vide pour un accès par tunnel SSH.
DOMAIN=
