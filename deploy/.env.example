# --- à remplir -------------------------------------------------------------------------------------------
# Mot de passe d'accès au hub (OBLIGATOIRE : le hub refuse de démarrer sans lui). Longue phrase conseillée.
HUB_ADMIN_USER=admin
HUB_PASSWORD=
# Fuseau horaire (heures affichées dans l'interface et le journal)
TZ=Europe/Paris

# --- accès par domaine (profil https) ----------------------------------------------------------------------
# Nom de domaine qui pointe vers le VPS (enregistrement A/AAAA). Laisse vide pour un accès par tunnel SSH.
DOMAIN=
# À mettre à 1 avec Caddy : lit l'adresse réelle du visiteur et marque le cookie « Secure ».
HUB_TRUST_PROXY=0
HUB_SECURE_COOKIE=0

# --- Claude ------------------------------------------------------------------------------------------------
# Option A : clé API (facturation à l'usage). Option B : laisse vide et connecte-toi avec « docker compose exec -it hub claude ».
ANTHROPIC_API_KEY=

# Port local du serveur sur lequel le hub est publié (127.0.0.1 uniquement). Change-le si 8787 est déjà pris.
HUB_HOST_PORT=8787
